# ============================================
# Configuração do Servidor de E-mail (IMAP)
# ============================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=seu-email@exemplo.com
IMAP_PASSWORD=sua-app-password-aqui
IMAP_FOLDERS=INBOX

# Remetentes usados nas regras de filtro
# Deixe em branco para desativar a regra correspondente
ZABBIX_SENDER=zabbix@exemplo.com
SISTEMA_PROCESSOS_SENDER=sistema.processos@exemplo.com
SUAP_SENDER=suap.noreply@exemplo.com

# ============================================
# Configuração da Aplicação
# ============================================
APP_HOST=0.0.0.0
APP_PORT=8000

# Intervalo de reconexão IMAP em segundos
IMAP_RECONNECT_DELAY=5

# Timeout do IDLE em segundos
IMAP_IDLE_TIMEOUT=300

# Reload automático do Uvicorn — deixar false em produção (o PM2 corre run.py)
RELOAD=false

# Arquiva uma única vez todo o backlog "open" importado para a base (para os
# contadores do dashboard começarem do zero). Deixar vazio/remover após correr.
APP_ARCHIVE_BACKLOG=true

# Caminho do SQLite. Por omissão aponta para notification_app/notifications.db,
# resolvido a partir da localização do código (independente do cwd).
# Só precisa de ser definido para usar outra base de dados.
# DATABASE_PATH=/caminho/absolato/notifications.db
